# Copia este archivo como .env y completa los valores.
# .env NUNCA se sube al repo (está en .gitignore) — este template sí.

# --- Requeridas ---

# Crea una cuenta gratis en https://console.groq.com y genera una API key.
GROQ_API_KEY=

# Crea una cuenta gratis en https://serpapi.com y genera una API key.
SERPAPI_API_KEY=

# --- Recomendada (agente_server.py) ---

# Token Bearer que deben mandar los clientes del servidor HTTP. Si la dejas
# vacía, se genera una al azar en cada arranque — en Cloud Run o cualquier
# despliegue real, fíjala aquí para que no cambie en cada cold start.
AGENT_API_KEY=

# --- Opcionales ---

# Suben el rate limit de las APIs de GitHub/GitLab, usadas por las tools
# fetch_github_profile/fetch_gitlab_profile (consultan perfiles bajo demanda,
# no indexan nada de antemano).
GITHUB_TOKEN=
GITLAB_TOKEN=

# Endpoint compatible con Open Responses (default: Groq)
LLM_BASE_URL=

# Modelo a usar en Groq (default: openai/gpt-oss-120b)
MODEL_NAME=

# Lista de modelos separados por coma: si el primero se queda sin cupo
# diario en Groq, se prueba el siguiente automáticamente.
# (default: "MODEL_NAME,openai/gpt-oss-20b")
MODEL_FALLBACK_CHAIN=

# Sampling del modelo (default: 1 y 1)
TEMPERATURE=
TOP_P=

# Tope de vueltas del loop de tool-calling antes de rendirse (default: 4)
MAX_TOOL_ITERATIONS=

# Tope de tokens de salida por llamada al modelo (razonamiento + respuesta
# visible juntos, con modelos de razonamiento como gpt-oss). (default: 4096)
MAX_OUTPUT_TOKENS=

# Metadatos mostrados en /.well-known/agent-card.json
AGENT_NAME=
AGENT_DESCRIPTION=
